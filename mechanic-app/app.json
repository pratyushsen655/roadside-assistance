{
  "expo": {
    "name": "RideRescue Mechanic",
    "slug": "mechanic-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "The app accesses your photos to let you upload registration documents.",
        "NSCameraUsageDescription": "The app accesses your camera to let you take photos for registration documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.prateeksen655.mechanicapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAzK4H6wmJV6pZaP1xHJBt6pUM3gJjNrQg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload registration documents.",
          "cameraPermission": "The app accesses your camera to let you take photos for registration documents."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-sharing",
      "expo-localization",
      "expo-status-bar",
      "expo-audio",
      "./plugins/withIncomingSound.js"
    ],
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "ff58687d-9da8-4c2a-94af-1ec17ef14b85"
      }
    },
    "owner": "prateeksen655"
  }
}